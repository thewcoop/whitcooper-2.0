---
import Layout from '../layouts/Layout.astro';
const email = 'thewhitcooper@gmail.com';
---
<Layout title="Contact" description="Get in touch with Whit Cooper.">
  <section class="page ct">
    <header class="page-head reveal">
      <p class="page-label">Contact</p>
      <h1 class="page-title">Say hello.</h1>
      <p class="page-sub">Got something atypical? Perfect. Tell me what you're making.</p>
    </header>

    <a class="ct-mail reveal" href={`mailto:${email}`}><span class="chroma-hover">{email}</span><span class="ct-arrow" aria-hidden="true">→</span></a>

    <div class="ct-socials reveal">
      <a href="https://soundcloud.com/thewhitcooper" aria-label="SoundCloud" class="ct-bubble"><svg class="ct-icon" viewBox="0 0 74.99 33.57" fill="currentColor">
          <g>
            <path d="M74.98,23.6c-.32,5.62-5,9.99-10.63,9.91h-25.55c-1.17-.01-2.11-.96-2.12-2.13V3.87c-.04-.97.52-1.86,1.41-2.24C38.09,1.63,40.44,0,45.39,0c3.02,0,5.99.81,8.59,2.36,4.1,2.41,7,6.43,8,11.08.88-.25,1.79-.37,2.71-.37,5.65-.04,10.26,4.52,10.29,10.17,0,.12,0,.24,0,.36Z"/>
