            <path d="M28.33,8.81c-.05-.48-.48-.82-.96-.77-.41.04-.73.37-.77.77-.92,7.96-.92,15.99,0,23.95.07.47.52.8.99.73.38-.06.67-.35.73-.73,1.03-7.95,1.04-16,.01-23.95Z"/>
            <path d="M23.14,8c-.05-.46-.47-.79-.93-.74-.39.04-.7.35-.74.74-.79,8.44-1.19,16.32,0,24.74,0,.46.37.83.83.83.46,0,.83-.37.83-.83,1.23-8.53.85-16.19.01-24.74Z"/>
            <path d="M17.98,10.41c0-.47-.39-.86-.86-.86-.47,0-.86.38-.86.86-.96,7.42-.96,14.94,0,22.36.05.47.47.8.94.75.4-.04.71-.36.75-.75,1.03-7.42,1.05-14.94.03-22.36Z"/>
            <path d="M12.77,16c0-.47-.38-.85-.85-.85-.47,0-.85.38-.85.85-1.23,5.76-.65,11,.05,16.83.07.44.49.74.93.67.35-.05.62-.33.67-.67.77-5.91,1.36-11.03.05-16.83Z"/>
            <path d="M7.6,15.12c-.05-.48-.49-.83-.97-.78-.41.04-.74.37-.78.78-1.09,5.88-.73,11.06.03,16.93.08.89,1.59.88,1.69,0,.84-5.96,1.23-10.99.03-16.93Z"/>
            <path d="M2.38,18c-.05-.48-.49-.83-.97-.78-.41.04-.74.37-.78.78-1,3.95-.69,7.22.07,11.18.05.45.46.77.91.72.38-.04.68-.34.72-.72.88-4.04,1.31-7.24.05-11.18Z"/>
          </g>
        </svg><span>SoundCloud</span></a>
      <a href="https://www.instagram.com/thewcoop/" aria-label="Instagram" class="ct-bubble"><svg class="ct-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg><span>Instagram</span></a>
      <a href="https://www.linkedin.com/in/whit-cooper/" aria-label="LinkedIn" class="ct-bubble"><svg class="ct-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg><span>LinkedIn</span></a>
    </div>
  </section>
</Layout>

<style>
  .ct-mail { display: inline-flex; align-items: baseline; gap: 18px; color: #fff; text-decoration: none; font-family: 'Inter', sans-serif; font-size: clamp(24px, 5.6vw, 64px); font-weight: 800; letter-spacing: -.035em; line-height: 1.05; border-bottom: 1px solid rgba(255,255,255,.3); padding-bottom: 10px; word-break: break-all; }
  .ct-arrow { color: #8d8d92; transition: transform .35s cubic-bezier(.2,.8,.2,1), color .3s; }
  .ct-mail:hover .ct-arrow, .ct-mail:focus-visible .ct-arrow { transform: translateX(10px); color: #fff; }
  .ct-mail:focus-visible, .ct-bubble:focus-visible { outline: 2px solid #fff; outline-offset: 6px; }
  .ct-socials { margin-top: 72px; display: flex; flex-wrap: wrap; gap: 14px; }
  .ct-bubble { display: inline-flex; align-items: center; gap: 12px; padding: 12px 22px 12px 16px; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; color: #e4e4e8; text-decoration: none; font-size: 15px; transition: border-color .25s, transform .25s; }
  .ct-bubble:hover { transform: translateY(-2px); }
  .ct-icon { width: 24px; height: 24px; flex: none; fill: currentColor; transition: filter .3s; }
  @media (prefers-reduced-motion: reduce) { .ct-arrow, .ct-bubble, .ct-icon { transition: none; } }
</style>
