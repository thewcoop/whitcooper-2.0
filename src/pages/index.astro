---
import Base from '../layouts/Base.astro';
import OrbHero from '../components/OrbHero.astro';
import { getEntry, getCollection } from 'astro:content';
import { inlineMd } from '../lib/inline-md';
import '../styles/home.css';

const { data: home } = await getEntry('home', 'homepage');

// Best three: the projects chosen in Studio (falls back to the first three).
const portfolio = await getCollection('portfolio');
const picked = (home.featured ?? []).map((id) => portfolio.find((p) => p.slug === id)).filter(Boolean);
const featured = (picked.length ? picked : portfolio).slice(0, 3);
const watchUrl = (u: string) => u.split('?')[0];

// What I do: ordered by the optional `order` field, then file name.
const skills = (await getCollection('skills')).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999) || a.id.localeCompare(b.id));

// Latest posts: newest three that are published.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
const fmt = (d: string | Date) => new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const bg = (u?: string) => (u ? `--img:url("${encodeURI(u)}")` : '');
---
<Base title="Whit Cooper | Editor, motion designer, colorist" bare overlayNav navLogo={false}>
  <OrbHero tagline={home.tagline} />

  <main>
    <section class="home-sec" id="intro">
      <p class="home-intro reveal" set:html={inlineMd(home.intro ?? '')} />
    </section>

    <section class="home-sec" id="work">
      <h2 class="home-h2 reveal">Best three</h2>
      <div class="best">
        {featured.map((p) => (
          <a class="proj reveal" href={watchUrl(p.data.videoURL)} target="_blank" rel="noopener noreferrer">
            <div class={`ca-img ${p.data.thumbnail ? '' : 'empty'}`} style={bg(p.data.thumbnail)}><i></i></div>
            <div class="tags">{p.data.tags.slice(0, 3).join(' · ')}</div>
            <h3>{p.data.title}</h3>
            {p.data.description && <p>{p.data.description.length > 130 ? p.data.description.slice(0, 127).trimEnd() + '…' : p.data.description}</p>}
          </a>
        ))}
      </div>
      <a class="more-link reveal" href="/portfolio">See all work →</a>
    </section>

    <section class="home-sec" id="what-i-do">
      <h2 class="home-h2 reveal">What I do</h2>
      <div class="skills reveal">
        {skills.map((s, i) => (
          <div class="skill">
            <button type="button" aria-expanded="false" aria-controls={`skill-${i}`}>
              <h3>{s.data.name}</h3><span class="plus" aria-hidden="true">+</span>
            </button>
            <div class="more" id={`skill-${i}`}>
              <div>
                <p class="pov">{s.data.pov}</p>
                {s.data.highlights?.length > 0 && (
                  <ul>
                    {s.data.highlights.map((h) => (
                      <li>{h.item === 'Enter wooper.world' ? <a href="https://wooper.world" target="_blank" rel="noopener noreferrer">Enter wooper.world</a> : h.item}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="home-sec" id="latest">
      <h2 class="home-h2 reveal">Latest</h2>
      <div class="posts reveal">
        {posts.map((p) => (
          <a class="post" href={`/blog/${p.slug}/`}>
            <div class={`ca-img ${p.data.coverImage ? '' : 'empty'}`} style={bg(p.data.coverImage)}><i></i></div>
            <div><h3>{p.data.title}</h3>{p.data.summary && <p>{p.data.summary}</p>}</div>
            <time datetime={String(p.data.date)}>{fmt(p.data.date)}</time>
          </a>
        ))}
      </div>
      <a class="more-link reveal" href="/blog">All posts →</a>
    </section>

    <footer class="home-foot reveal">
      <div>Wooper makes music at <a href="https://wooper.world" target="_blank" rel="noopener noreferrer">wooper.world</a></div>
      <div><a href="/contact">Say hello</a></div>
    </footer>
  </main>
</Base>

<script>
  // Skill rows open and close; sections fade up as they scroll into view.
  document.querySelectorAll<HTMLElement>('.skill > button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.parentElement!;
      const open = row.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
