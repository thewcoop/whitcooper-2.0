---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { inlineMd } from '../lib/inline-md';

const about = (await getCollection('about'))[0]?.data;
const title = about?.title || 'Whit Cooper';
const subtitle = about?.subtitle || 'Creative Video Editor & Motion Designer';
const description = about?.description || "Hi! I'm a Dallas-based creative professional who transforms raw footage into compelling stories.";
const headshot = about?.headshot || 'https://i.imgur.com/3LwyDts.png';
---
<Layout title="About" description={description.slice(0, 160)} image={about?.headshot}>
  <section class="page">
    <div class="ab-grid">
      <div class="ab-photo reveal">
        <div class="ca-img ab-img" style={`--img:url("${encodeURI(headshot)}")`} role="img" aria-label={title}><i></i></div>
      </div>

      <div class="ab-text">
        <p class="page-label reveal">About</p>
        <h1 class="page-title reveal">{title}</h1>
        <p class="ab-sub reveal">{subtitle}</p>
        <p class="ab-body reveal" set:html={inlineMd(description)} />
        {about?.additionalContent && <div class="ab-more prose prose-invert reveal" set:html={about.additionalContent} />}
        <p class="ab-links reveal"><a class="text-link" href="/portfolio">See my work</a><span aria-hidden="true">·</span><a class="text-link" href="/contact">Say hello</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ab-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: start; }
  @media (max-width: 860px) { .ab-grid { grid-template-columns: 1fr; gap: 34px; } .ab-photo { max-width: 300px; } }
  .ab-img { aspect-ratio: 1/1; border-radius: 50%; }
  .ab-text .page-title { font-size: clamp(40px, 7vw, 84px); }
  .ab-sub { margin: 20px 0 0; font-family: 'Inter', sans-serif; font-size: clamp(18px, 2.4vw, 26px); font-weight: 300; color: #d4d4d8; line-height: 1.3; }
  .ab-body { margin: 28px 0 0; font-size: 19px; line-height: 1.75; color: #c5c5ca; max-width: 34em; }
  .ab-more { margin-top: 24px; max-width: 34em; color: #c5c5ca; }
  .ab-more a { color: #fff; }
  .ab-links { margin: 36px 0 0; display: flex; gap: 14px; align-items: center; color: #55555a; font-size: 17px; }
</style>
