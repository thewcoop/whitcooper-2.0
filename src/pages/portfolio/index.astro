---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio');
const tags = ['Editing', 'Motion Graphics', 'VFX', 'Color', 'Sound Design'].filter((t) => projects.some((p) => p.data.tags.includes(t)));
const bg = (u?: string) => (u ? `--img:url("${encodeURI(u)}")` : '');
---
<Layout title="Portfolio" description="Video editing, motion graphics, VFX, color and more by Whit Cooper.">
  <section class="page">
    <header class="page-head reveal">
      <p class="page-label">Selected work</p>
      <h1 class="page-title">Portfolio</h1>
      <p class="page-sub">Editing, motion graphics, VFX, color and sound. Tap a project to watch it.</p>
    </header>

    {tags.length > 1 && (
      <div class="pf-filters reveal" role="group" aria-label="Filter by skill">
        {tags.map((t) => <button type="button" class="pill" data-filter={t} aria-pressed="false">{t}</button>)}
      </div>
    )}

    <div class="pf-grid" id="pf-grid">
      {projects.map(({ data }) => (
        <button
          type="button"
          class="pf-card reveal"
          data-tags={data.tags.join('|')}
          data-title={data.title}
          data-description={data.description ?? ''}
          data-video={data.videoURL}
        >
          <div class={`ca-img pf-thumb ${data.thumbnail ? '' : 'empty'}`} style={bg(data.thumbnail)}>
            <i></i>
            <span class="pf-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
          </div>
          <span class="pf-tags">{data.tags.slice(0, 3).join(' · ')}</span>
          <span class="pf-title chroma-hover">{data.title}</span>
          {data.description && <span class="pf-desc">{data.description}</span>}
        </button>
      ))}
    </div>

    <p class="pf-empty" id="pf-empty" hidden>Nothing matches all of those. Try removing a filter.</p>
    {projects.length === 0 && <p class="pf-empty">New work is on the way.</p>}
  </section>

  <!-- Video theater -->
  <div class="pf-theater" id="pf-theater" hidden role="dialog" aria-modal="true" aria-labelledby="pf-t-title">
    <div class="pf-backdrop" id="pf-backdrop"></div>
    <div class="pf-window" id="pf-window">
      <div class="pf-bar"><h2 id="pf-t-title"></h2><button type="button" class="pf-close" id="pf-close" aria-label="Close video">✕</button></div>
      <div class="pf-video" id="pf-video"></div>
      <p class="pf-t-desc" id="pf-t-desc"></p>
      <div class="pf-t-tags" id="pf-t-tags"></div>
    </div>
  </div>
</Layout>

<script>
  // ---- filters: pick one or more skills; a project must have all of them ----
  const cards = [...document.querySelectorAll<HTMLElement>('.pf-card')];
  const pills = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const empty = document.getElementById('pf-empty')!;
  const selected = new Set<string>();
  const apply = () => {
    let shown = 0;
    cards.forEach((c) => {
      const t = (c.dataset.tags || '').split('|').filter(Boolean);
      const show = [...selected].every((s) => t.includes(s));
      c.hidden = !show; if (show) shown++;
    });
    empty.hidden = shown > 0 || cards.length === 0;
  };
  pills.forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.filter!;
    selected.has(t) ? selected.delete(t) : selected.add(t);
    b.setAttribute('aria-pressed', String(selected.has(t)));
    apply();
  }));

  // ---- theater: plays the video on the page ----
  const theater = document.getElementById('pf-theater')!;
  const win = document.getElementById('pf-window')!;
  const videoBox = document.getElementById('pf-video')!;
  const closeBtn = document.getElementById('pf-close')!;
  let opener: HTMLElement | null = null;

  const embed = (raw: string) => {
    const yt = raw.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
    if (yt) return `https://www.youtube.com/embed/${yt[1]}?rel=0`;
    const vm = raw.match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/([a-f0-9]+))?/);
    if (vm) return `https://player.vimeo.com/video/${vm[1]}?dnt=1&title=0&byline=0&portrait=0${vm[2] ? `&h=${vm[2]}` : ''}`;
    return '';
  };

  const open = (card: HTMLElement) => {
    opener = card;
    document.getElementById('pf-t-title')!.textContent = card.dataset.title || '';
    document.getElementById('pf-t-desc')!.textContent = card.dataset.description || '';
    const tagBox = document.getElementById('pf-t-tags')!; tagBox.replaceChildren();
    (card.dataset.tags || '').split('|').filter(Boolean).forEach((t) => { const s = document.createElement('span'); s.textContent = t; tagBox.append(s); });
    videoBox.replaceChildren();
    const src = embed(card.dataset.video || '');
    if (src) {
      const f = document.createElement('iframe'); f.src = src; f.allow = 'autoplay; fullscreen; picture-in-picture'; f.referrerPolicy = 'strict-origin-when-cross-origin'; f.setAttribute('allowfullscreen', ''); f.title = card.dataset.title || 'Video';
      videoBox.append(f);
    } else {
      const a = document.createElement('a'); a.href = card.dataset.video || '#'; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.className = 'text-link'; a.textContent = 'Open the video'; videoBox.append(a);
    }
    theater.hidden = false;
    requestAnimationFrame(() => theater.classList.add('on'));
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  };
  const close = () => {
    if (theater.hidden) return;
    theater.classList.remove('on');
    document.body.style.overflow = '';
    setTimeout(() => { theater.hidden = true; videoBox.replaceChildren(); opener?.focus(); }, 300);   // stops playback
  };
  cards.forEach((c) => c.addEventListener('click', () => open(c)));
  closeBtn.addEventListener('click', close);
  document.getElementById('pf-backdrop')!.addEventListener('click', close);
  addEventListener('keydown', (e) => {
    if (theater.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') { e.preventDefault(); closeBtn.focus(); }      // keep focus inside while open
  });
</script>

<style is:global>
  .pf-filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }
  .pf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px 20px; }
  @media (max-width: 960px) { .pf-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .pf-grid { grid-template-columns: 1fr; } }
  .pf-card { background: none; border: 0; padding: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; display: grid; gap: 12px; align-content: start; }
  .pf-card[hidden] { display: none; }
  .pf-thumb { aspect-ratio: 16/10; border-radius: 4px; }
  .pf-card:hover .ca-img::before, .pf-card:focus-visible .ca-img::before { transform: translate(-7px, -2px); }
  .pf-card:hover .ca-img::after, .pf-card:focus-visible .ca-img::after { transform: translate(7px, 2px); }
  .pf-card:focus-visible { outline: 2px solid #fff; outline-offset: 6px; }
  .pf-play { position: absolute; z-index: 5; left: 50%; top: 50%; width: 54px; height: 54px; margin: -27px 0 0 -27px; border-radius: 50%; border: 1px solid rgba(255,255,255,.7); background: rgba(0,0,0,.45); color: #fff; display: grid; place-items: center; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transition: transform .35s cubic-bezier(.2,.8,.2,1), background .3s; }
  .pf-card:hover .pf-play, .pf-card:focus-visible .pf-play { transform: scale(1.12); background: rgba(255,255,255,.18); }
  .pf-tags { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #8d8d92; }
  .pf-title { font-family: 'Inter', sans-serif; font-size: 22px; font-weight: 800; letter-spacing: -.02em; line-height: 1.15; }
  .pf-desc { color: #8d8d92; font-size: 14px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pf-empty { color: #8d8d92; padding: 40px 0; }

  .pf-theater { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 18px; opacity: 0; transition: opacity .3s; }
  .pf-theater[hidden] { display: none; }
  .pf-theater.on { opacity: 1; }
  .pf-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .pf-window { position: relative; width: min(1100px, 100%); max-height: 94vh; overflow: auto; background: #0a0a0a; border: 1px solid rgba(255,255,255,.16); border-radius: 6px; padding: 18px 18px 22px; transform: scale(.96) translateY(10px); transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .pf-theater.on .pf-window { transform: none; }
  .pf-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 14px; }
  .pf-bar h2 { margin: 0; font-family: 'Inter', sans-serif; font-size: clamp(20px, 3vw, 30px); font-weight: 800; letter-spacing: -.02em; }
  .pf-close { background: none; border: 1px solid rgba(255,255,255,.25); color: #fff; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-size: 16px; flex: none; }
  .pf-close:hover { border-color: #fff; }
  .pf-video { aspect-ratio: 16/9; background: #000; border-radius: 4px; overflow: hidden; display: grid; place-items: center; }
  .pf-video iframe { width: 100%; height: 100%; border: 0; }
  .pf-t-desc { color: #c5c5ca; font-size: 17px; line-height: 1.6; margin: 16px 0 12px; max-width: 46em; }
  .pf-t-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .pf-t-tags span { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #8d8d92; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: 5px 12px; }
  @media (prefers-reduced-motion: reduce) { .pf-theater, .pf-window, .pf-play { transition: none; } }
</style>
