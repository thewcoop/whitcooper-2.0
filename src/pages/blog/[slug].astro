---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<Layout title={post.data.title} description={post.data.summary} image={post.data.coverImage}>
  <article class="post-page">
    <a href="/blog" class="post-back">← All posts</a>

    <header class="post-head">
      <time class="post-date" datetime={String(post.data.date)}>
        {new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1 class="post-title">{post.data.title}</h1>
      {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
    </header>

    {post.data.coverImage && (
      <div class="cover-wrap"><img src={post.data.coverImage} alt={post.data.title} class="cover-img" /></div>
    )}

    <!-- Post content -->
    <div class="post-content prose prose-invert prose-lg max-w-none">
      <Content />

      {/* Render photo layout groups */}
      {post.data.imageGroups && post.data.imageGroups.length > 0 && (
        <div class="image-groups mt-8 space-y-8">
          {post.data.imageGroups.map((group, groupIndex) => (
            <div class={`image-group layout-${group.layout}`}>
              {group.images.map((item, imageIndex) => (
                <figure class="image-item">
                  <img
                    src={item.image}
                    alt={item.alt || item.caption || `Photo ${imageIndex + 1}`}
                    loading="lazy"
                  />
                  {item.caption && (
                    <figcaption>{item.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          ))}
        </div>
      )}
    </div>

    <footer class="post-foot"><a href="/blog" class="post-back">← All posts</a></footer>
  </article>
</Layout>

<style>
  /* Page frame */
  .post-page { max-width: 860px; margin: 0 auto; padding: 48px 22px 110px; }
  .post-back { display: inline-block; color: #8d8d92; text-decoration: none; font-size: 14px; letter-spacing: .08em; transition: color .25s, transform .25s; }
  .post-back:hover { color: #fff; transform: translateX(-3px); }
  .post-head { margin: 36px 0 40px; }
  .post-date { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #8d8d92; }
  .post-title { margin: 12px 0 0; font-family: 'Inter', sans-serif; font-size: clamp(40px, 8vw, 88px); font-weight: 800; letter-spacing: -.045em; line-height: .96; }
  .post-summary { margin: 22px 0 0; font-size: clamp(18px, 2.2vw, 22px); font-weight: 300; color: #c5c5ca; max-width: 34em; line-height: 1.5; font-family: 'Inter', sans-serif; }
  .post-foot { margin-top: 70px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.16); }

  /* Cover image */
  .cover-wrap { margin: 0 0 44px; border-radius: 4px; overflow: hidden; }
  .cover-img { width: 100%; height: auto; max-height: 560px; object-fit: cover; display: block; }

  .post-head, .post-content, .cover-wrap { animation: fadeInUp 0.8s ease-out both; }
  .post-content { animation-delay: 0.15s; }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .post-head, .post-content, .cover-wrap { animation: none; } }

  /* Enhanced prose styling */
  .prose {
    color: #f6f6f6;
  }

  .prose h2, .prose h3, .prose h4 {
    color: #fafafa;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .prose a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,.4);
    transition: border-color 0.3s ease;
  }

  .prose a:hover {
    border-bottom-color: #fff;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 2px solid #fff;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #a1a1aa;
  }

  .prose code {
    background: rgba(255,255,255,0.1);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .prose pre {
    background: rgba(0,0,0,0.3);
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 2rem 0;
  }

  /* Clean, responsive image styling for local uploads */
  .prose img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    margin: 2rem auto;
    display: block;
    max-width: 100%;
  }

  /* Ensure images are responsive */
  .prose figure {
    margin: 2rem 0;
  }

  .prose figure img {
    margin: 0;
  }

  /* Override Tailwind prose spacing with CSS custom properties */
  .prose {
    --tw-prose-spacing: 2rem;
    --tw-prose-vertical-spacing: 2rem;
  }

  /* Force more spacing between prose elements */
  .prose > * + * {
    margin-top: 2rem;
  }

  /* Extra spacing for images */
  .prose > * + img {
    margin-top: 3rem;
  }

  .prose > img + * {
    margin-top: 3rem;
  }

  /* Prevent the row-spacing rule from adding top margin inside grid cells */
  :global(.prose div.cms-photo-row figure + figure) {
    margin-top: 0;
  }

  /* Photo layout groups */
  .image-group {
    display: grid;
    gap: 0.75rem;
  }

  .image-group.layout-full {
    grid-template-columns: 1fr;
  }

  .image-group.layout-two-up {
    grid-template-columns: 1fr 1fr;
  }

  .image-group.layout-three-up {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .image-group.layout-four-up {
    grid-template-columns: 1fr 1fr 1fr 1fr;
  }

  /* Stack to 2 columns on small screens */
  @media (max-width: 640px) {
    .image-group.layout-three-up,
    .image-group.layout-four-up {
      grid-template-columns: 1fr 1fr;
    }
  }

  .image-item {
    margin: 0;
  }

  .image-item img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    margin: 0;
  }

  /* Full-width images don't need forced aspect ratio */
  .layout-full .image-item img {
    aspect-ratio: unset;
    max-height: 80vh;
    object-fit: contain;
    background: rgba(0,0,0,0.2);
  }

  .image-item figcaption {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    color: #888;
    text-align: center;
    font-style: italic;
  }

  /* Clear floats so the next block-level element starts fresh */
  .post-content::after {
    content: '';
    display: table;
    clear: both;
  }

  /*
   * ── cms-photo & cms-photo-row ──────────────────────────────────────────
   * These elements come from raw HTML blocks in markdown (CMS editor
   * components). Astro's scoped CSS does NOT add the cid attribute to raw
   * HTML blocks, so the rules below use :global() to match them directly.
   * ────────────────────────────────────────────────────────────────────── */

  /* ── cms-photo: single positioned photo ── */
  :global(.prose figure.cms-photo) {
    margin: 2rem 0;
  }

  :global(.prose figure.cms-photo[data-align="center"]) {
    display: block;
    margin-left:  auto;
    margin-right: auto;
  }
  :global(.prose figure.cms-photo[data-align="center"][data-size="full"])   { max-width: 100%; }
  :global(.prose figure.cms-photo[data-align="center"][data-size="large"])  { max-width: 70%;  }
  :global(.prose figure.cms-photo[data-align="center"][data-size="medium"]) { max-width: 50%;  }
  :global(.prose figure.cms-photo[data-align="center"][data-size="small"])  { max-width: 33%;  }

  :global(.prose figure.cms-photo[data-align="left"]) {
    float: left;
    margin: 0 2rem 1.5rem 0;
  }
  :global(.prose figure.cms-photo[data-align="right"]) {
    float: right;
    margin: 0 0 1.5rem 2rem;
  }
  :global(.prose figure.cms-photo[data-align="left"][data-size="full"]),
  :global(.prose figure.cms-photo[data-align="right"][data-size="full"])   { width: 100%; }
  :global(.prose figure.cms-photo[data-align="left"][data-size="large"]),
  :global(.prose figure.cms-photo[data-align="right"][data-size="large"])  { width: 70%;  }
  :global(.prose figure.cms-photo[data-align="left"][data-size="medium"]),
  :global(.prose figure.cms-photo[data-align="right"][data-size="medium"]) { width: 50%;  }
  :global(.prose figure.cms-photo[data-align="left"][data-size="small"]),
  :global(.prose figure.cms-photo[data-align="right"][data-size="small"])  { width: 33%;  }

  :global(.prose figure.cms-photo img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    display: block;
    margin: 0;
  }
  :global(.prose figure.cms-photo[data-aspect="square"] img)    { aspect-ratio: 1 / 1;  object-fit: cover; }
  :global(.prose figure.cms-photo[data-aspect="landscape"] img) { aspect-ratio: 16 / 9; object-fit: cover; }
  :global(.prose figure.cms-photo[data-aspect="portrait"] img)  { aspect-ratio: 3 / 4;  object-fit: cover; }

  :global(.prose figure.cms-photo figcaption) {
    text-align: center;
    font-size: 0.8rem;
    color: #888;
    font-style: italic;
    margin-top: 0.4rem;
  }

  /* ── cms-video: responsive YouTube/Vimeo embed ── */
  :global(.prose div.cms-video) {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 2rem 0;
    border-radius: 12px;
    overflow: hidden;
  }
  :global(.prose div.cms-video iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── cms-photo-row: multi-column photo grid ── */
  :global(.prose div.cms-photo-row) {
    display: grid;
    gap: 0.75rem;
    margin: 2rem 0;
    clear: both;
  }
  :global(.prose div.cms-photo-row[data-cols="2"]) { grid-template-columns: 1fr 1fr; }
  :global(.prose div.cms-photo-row[data-cols="3"]) { grid-template-columns: 1fr 1fr 1fr; }
  :global(.prose div.cms-photo-row[data-cols="4"]) { grid-template-columns: 1fr 1fr 1fr 1fr; }

  @media (max-width: 640px) {
    :global(.prose div.cms-photo-row) {
      grid-template-columns: 1fr !important;
    }
  }

  :global(.prose div.cms-photo-row figure) {
    margin: 0;
  }

  :global(.prose div.cms-photo-row img) {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    margin: 0;
  }

  :global(.prose div.cms-photo-row[data-aspect="landscape"] img) { aspect-ratio: 16 / 9; object-fit: cover; }
  :global(.prose div.cms-photo-row[data-aspect="square"] img)    { aspect-ratio: 1 / 1;  object-fit: cover; }
  :global(.prose div.cms-photo-row[data-aspect="portrait"] img)  { aspect-ratio: 3 / 4;  object-fit: cover; }

  :global(.prose div.cms-photo-row figcaption) {
    text-align: center;
    font-size: 0.75rem;
    color: #888;
    font-style: italic;
    margin-top: 0.35rem;
  }
</style>
