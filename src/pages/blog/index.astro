---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const fmt = (d: string | Date) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const bg = (u?: string) => (u ? `--img:url("${encodeURI(u)}")` : '');
---
<Layout title="Blog" description="Trips, photos, and behind-the-scenes notes from Whit Cooper.">
  <section class="page">
    <header class="page-head reveal">
      <p class="page-label">Journal</p>
      <h1 class="page-title">Blog</h1>
      <p class="page-sub">Trips, photos, and notes from behind the scenes.</p>
    </header>

    <div class="hair">
      {posts.map((post) => (
        <a class="bl-row rowtint reveal" href={`/blog/${post.slug}/`}>
          <div class={`ca-img bl-cover ${post.data.coverImage ? '' : 'empty'}`} style={bg(post.data.coverImage)}><i></i></div>
          <div class="bl-text">
            <time datetime={String(post.data.date)}>{fmt(post.data.date)}</time>
            <h2 class="chroma-hover">{post.data.title}</h2>
            {post.data.summary && <p>{post.data.summary}</p>}
          </div>
          <span class="bl-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    {posts.length === 0 && <p class="bl-empty">The first post is on the way.</p>}
  </section>
</Layout>

<style>
  .bl-row { display: grid; grid-template-columns: 150px 1fr auto; gap: 28px; align-items: center; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,.16); text-decoration: none; color: inherit; }
  .bl-cover { width: 150px; aspect-ratio: 4/5; border-radius: 4px; }
  .bl-text time { font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: #8d8d92; }
  .bl-text h2 { margin: 6px 0 8px; font-family: 'Inter', sans-serif; font-size: clamp(26px, 4.4vw, 48px); font-weight: 800; letter-spacing: -.035em; line-height: 1.05; }
  .bl-text p { margin: 0; color: #a1a1aa; font-size: 17px; max-width: 36em; }
  .bl-arrow { font-size: 28px; color: #8d8d92; transition: transform .35s cubic-bezier(.2,.8,.2,1), color .3s; }
  .bl-row:hover .bl-arrow, .bl-row:focus-visible .bl-arrow { transform: translateX(8px); color: #fff; }
  .bl-row:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .bl-empty { color: #8d8d92; padding: 40px 0; }
  @media (max-width: 640px) {
    .bl-row { grid-template-columns: 96px 1fr; gap: 18px; padding: 18px 0; }
    .bl-cover { width: 96px; }
    .bl-arrow { display: none; }
    .bl-text p { font-size: 15px; }
  }
</style>
