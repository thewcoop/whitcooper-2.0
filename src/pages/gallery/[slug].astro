---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('gallery', ({ data }) => !data.draft);
  return all.map((c) => ({ params: { slug: c.id }, props: { c } }));
}

const { c } = Astro.props;
const { title, description, date, photos } = c.data;
const cover = photos.find((p) => p.src === c.data.cover) ?? photos[0];
const fmt = (d?: string | Date) => (d ? new Date(d).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '');
---
<Layout title={title} description={description || `${title}: ${photos.length} photos by Whit Cooper.`} image={cover?.src}>
  <section class="page">
    <a href="/gallery" class="gl-back">← All collections</a>
    <header class="page-head reveal" style="margin-top:34px">
      <p class="page-label">{photos.length} photo{photos.length === 1 ? '' : 's'}{date ? ` · ${fmt(date)}` : ''}</p>
      <h1 class="page-title">{title}</h1>
      {description && <p class="page-sub">{description}</p>}
    </header>

    <div class="gl-grid" id="gl-grid">
      {photos.map((p, i) => (
        <a class="gl-item" href={p.src} data-i={i} data-caption={p.caption ?? ''} data-alt={p.alt ?? p.caption ?? ''} style={`--r:${(p.w / p.h).toFixed(4)}`} aria-label={p.caption || `Open photo ${i + 1} of ${photos.length}`}>
          <div class="ca-img gl-pic">
            <img src={p.thumb} width={p.w} height={p.h} alt={p.alt || p.caption || ''} loading={i < 8 ? 'eager' : 'lazy'} decoding="async" />
          </div>
        </a>
      ))}
      <span class="gl-fill" aria-hidden="true"></span>
    </div>
  </section>

  <!-- full-screen viewer -->
  <div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <div class="lb-backdrop" id="lb-backdrop"></div>
    <button class="lb-btn lb-close" id="lb-close" aria-label="Close viewer">✕</button>
    <button class="lb-btn lb-nav lb-prev" id="lb-prev" aria-label="Previous photo">←</button>
    <figure class="lb-fig">
      <img id="lb-img" alt="" />
      <figcaption id="lb-cap"></figcaption>
    </figure>
    <button class="lb-btn lb-nav lb-next" id="lb-next" aria-label="Next photo">→</button>
    <div class="lb-count" id="lb-count" aria-live="polite"></div>
  </div>
</Layout>

<script>
  const items = [...document.querySelectorAll<HTMLAnchorElement>('.gl-item')];
  const lb = document.getElementById('lb')!;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const cap = document.getElementById('lb-cap')!;
  const count = document.getElementById('lb-count')!;
  const closeBtn = document.getElementById('lb-close')!;
  let index = 0;
  let opener: HTMLElement | null = null;

  const show = (i: number) => {
    index = (i + items.length) % items.length;
    const a = items[index];
    const thumb = a.querySelector('img')!.getAttribute('src')!;
    img.alt = a.dataset.alt || '';
    img.src = thumb;                               // instant placeholder while the full photo loads
    const full = new Image();
    full.onload = () => { if (items[index] === a) img.src = full.src; };
    full.src = a.getAttribute('href')!;
    cap.textContent = a.dataset.caption || '';
    cap.hidden = !a.dataset.caption;
    count.textContent = `${index + 1} / ${items.length}`;
    [index + 1, index - 1].forEach((n) => { const o = items[(n + items.length) % items.length]; if (o && o !== a) new Image().src = o.getAttribute('href')!; });   // warm the neighbours
  };
  const open = (i: number, from: HTMLElement) => {
    opener = from; show(i);
    lb.hidden = false; requestAnimationFrame(() => lb.classList.add('on'));
    document.body.style.overflow = 'hidden'; closeBtn.focus();
  };
  const close = () => {
    if (lb.hidden) return;
    lb.classList.remove('on'); document.body.style.overflow = '';
    setTimeout(() => { lb.hidden = true; img.removeAttribute('src'); opener?.focus(); }, 250);
  };
  items.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); open(i, a); }));
  document.getElementById('lb-prev')!.addEventListener('click', () => show(index - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => show(index + 1));
  closeBtn.addEventListener('click', close);
  document.getElementById('lb-backdrop')!.addEventListener('click', close);
  addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === 'ArrowRight') show(index + 1);
    else if (e.key === 'Tab') { e.preventDefault(); closeBtn.focus(); }
  });
  // swipe on a phone
  let x0 = 0, y0 = 0;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx) * 1.5) close();
  }, { passive: true });
</script>

<style is:global>
  .gl-back { display: inline-block; color: #8d8d92; text-decoration: none; font-size: 14px; letter-spacing: .08em; transition: color .25s, transform .25s; }
  .gl-back:hover { color: #fff; transform: translateX(-3px); }

  /* justified rows: every photo keeps its shape, rows fill the width, no layout jump while loading */
  .gl-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .gl-item { flex: calc(var(--r) * 100) 1 calc(var(--r) * 240px); min-width: 0; aspect-ratio: var(--r); display: block; }
  .gl-item:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .gl-pic { width: 100%; height: 100%; border-radius: 3px; background: #111; }
  .gl-fill { flex-grow: 999999; height: 0; }
  @media (max-width: 560px) { .gl-grid { gap: 5px; } .gl-item { flex: calc(var(--r) * 100) 1 calc(var(--r) * 115px); } }

  .lb { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; opacity: 0; transition: opacity .25s; }
  .lb[hidden] { display: none; }
  .lb.on { opacity: 1; }
  .lb-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .lb-fig { position: relative; margin: 0; max-width: min(94vw, 1500px); max-height: 94vh; display: grid; gap: 12px; justify-items: center; }
  .lb-fig img { max-width: 100%; max-height: calc(94vh - 56px); width: auto; height: auto; object-fit: contain; border-radius: 3px; }
  .lb-fig figcaption { color: #c5c5ca; font-size: 15px; text-align: center; max-width: 40em; min-height: 1.2em; }
  .lb-btn { position: absolute; z-index: 2; background: rgba(10,10,10,.6); border: 1px solid rgba(255,255,255,.25); color: #fff; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; font-size: 18px; display: grid; place-items: center; transition: border-color .2s, background .2s; }
  .lb-btn:hover { border-color: #fff; background: rgba(255,255,255,.12); }
  .lb-close { top: 16px; right: 16px; }
  .lb-nav { top: 50%; margin-top: -22px; }
  .lb-prev { left: 14px; } .lb-next { right: 14px; }
  .lb-count { position: absolute; left: 0; right: 0; bottom: 14px; text-align: center; color: #8d8d92; font-size: 13px; letter-spacing: .12em; z-index: 2; pointer-events: none; }
  @media (max-width: 600px) { .lb-nav { top: auto; bottom: 10px; margin-top: 0; } .lb-prev { left: 10px; } .lb-next { right: 10px; } .lb-fig img { max-height: calc(94vh - 110px); } }
  @media (prefers-reduced-motion: reduce) { .lb { transition: none; } }
</style>
